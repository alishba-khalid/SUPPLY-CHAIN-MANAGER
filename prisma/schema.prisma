// Prisma schema for Supply Chain Manager.
//
// Multi-tenant: every table carries `orgId` (a Clerk organization id), and
// every unique constraint and relation is *composite on orgId* rather than
// on the business key alone. This is deliberate, not decoration — it means
// there is no longer a valid Prisma call shape that looks up a row (or
// creates a relation) without also supplying the org, so a cross-tenant
// leak is a schema-level impossibility, not just an app-code discipline.
// See docs/metrics.md's "Multi-tenant data isolation" section.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionDirection {
  IN
  OUT
}

model Warehouse {
  id            Int      @id @default(autoincrement())
  orgId         String   @map("org_id")
  code          String
  name          String
  capacityUnits Int      @map("capacity_units")

  inventory     Inventory[]
  transactions  Transaction[]

  @@unique([orgId, code])
  @@unique([orgId, id]) // lets Inventory/Transaction FK to (orgId, warehouseId) — see below
  @@index([orgId])
  @@map("warehouses")
}

model Supplier {
  id            Int      @id @default(autoincrement())
  orgId         String   @map("org_id")
  supplierId    String   @map("supplier_id")
  name          String
  leadTimeDays  Int      @map("lead_time_days")
  // True only when the source data had no lead time and this fell back to
  // the 14-day default — NOT true whenever leadTimeDays happens to equal 14.
  // A supplier can genuinely have a real 14-day lead time; without this
  // flag persisted, the UI has no way to tell the two cases apart and the
  // lead-time warning banner false-positives on the real one.
  leadTimeMissing Boolean @default(false) @map("lead_time_missing")
  email         String

  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([orgId, supplierId])
  @@index([orgId])
  @@map("suppliers")
}

model Product {
  id         Int      @id @default(autoincrement())
  orgId      String   @map("org_id")
  sku        String
  name       String
  category   String
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [orgId, supplierId], references: [orgId, supplierId])

  inventory      Inventory[]
  purchaseOrders PurchaseOrder[]
  transactions   Transaction[]

  @@unique([orgId, sku])
  @@index([orgId, supplierId])
  @@map("products")
}

model Inventory {
  id             Int       @id @default(autoincrement())
  orgId          String    @map("org_id")
  sku            String
  product        Product   @relation(fields: [orgId, sku], references: [orgId, sku])
  warehouseId    Int       @map("warehouse_id")
  warehouse      Warehouse @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantityOnHand Int       @map("quantity_on_hand")

  @@unique([orgId, sku, warehouseId])
  @@index([orgId, sku])
  @@index([orgId, warehouseId])
  @@map("inventory")
}

model PurchaseOrder {
  id           Int       @id @default(autoincrement())
  orgId        String    @map("org_id")
  poNumber     String    @map("po_number")
  supplierId   String    @map("supplier_id")
  supplier     Supplier  @relation(fields: [orgId, supplierId], references: [orgId, supplierId])
  sku          String
  product      Product   @relation(fields: [orgId, sku], references: [orgId, sku])
  quantity     Int
  unitPrice    Decimal   @map("unit_price") @db.Decimal(12, 2)
  orderDate    DateTime  @map("order_date") @db.Date
  expectedDate DateTime  @map("expected_date") @db.Date
  receivedDate DateTime? @map("received_date") @db.Date

  @@unique([orgId, poNumber])
  @@index([orgId, sku])
  @@index([orgId, supplierId])
  @@index([orgId, orderDate])
  @@index([orgId, expectedDate])
  @@index([orgId, receivedDate])
  @@map("purchase_orders")
}

model Transaction {
  id          Int                  @id @default(autoincrement())
  orgId       String               @map("org_id")
  sku         String
  product     Product              @relation(fields: [orgId, sku], references: [orgId, sku])
  warehouseId Int                  @map("warehouse_id")
  warehouse   Warehouse            @relation(fields: [orgId, warehouseId], references: [orgId, id])
  quantity    Int
  direction   TransactionDirection
  date        DateTime             @db.Date
  // Set only on rows written by the smart importer: a hash of the row's
  // content plus its occurrence number among identical rows in the same
  // file. Re-importing the same file produces the same keys, so the commit
  // step skips them instead of duplicating the ledger — while two genuinely
  // identical movements in one file still get distinct keys. NULL for
  // seeded / manually created rows (Postgres treats NULLs as distinct).
  importKey   String?              @map("import_key")

  @@unique([orgId, importKey])
  @@index([orgId, sku])
  @@index([orgId, warehouseId])
  @@index([orgId, date])
  @@map("transactions")
}

// App-side settings for a Clerk organization. Clerk owns the organization
// itself; this row only carries knobs the app needs. A missing row means
// defaults everywhere.
model Organization {
  orgId                  String   @id @map("org_id")
  // Per-org ceiling on rows per import, overriding the plan's limit in
  // src/lib/subscriptions/tiers.ts (e.g. to give one reviewer a bigger
  // allowance). NULL = use the plan limit.
  importRowLimitOverride Int?     @map("import_row_limit_override")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

// One chunked smart-import upload. The browser sends rows in chunks; they
// land in import_staged_chunks and touch no real table until the commit step
// moves them all in a single transaction. Sessions older than 24h are
// deleted (chunks cascade) — see src/data/repositories/import-staging.ts.
model ImportSession {
  id            String   @id
  orgId         String   @map("org_id")
  // uploading -> committing -> committed | failed
  status        String
  // Content hash of the extracted rows — lets a re-selected file resume an
  // interrupted upload instead of starting over.
  fingerprint   String
  totalRows     Int      @map("total_rows")
  totalChunks   Int      @map("total_chunks")
  clearExisting Boolean  @map("clear_existing")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  chunks ImportStagedChunk[]

  @@unique([orgId, id])
  @@index([orgId, fingerprint])
  @@index([createdAt])
  @@map("import_sessions")
}

// One row per uploaded chunk (≤2,000 data rows), not one row per data row:
// a 21,586-row import writes 11 staging rows, so staging and its cleanup
// cost almost nothing and leave no bloat behind. `payload` groups the rows by
// entity — {"warehouse": [...], "transaction": [...]} — and every record
// carries `_row`, its 1-based position in its entity's list (the "Row N" in
// error messages). The commit expands them with jsonb_to_recordset.
model ImportStagedChunk {
  orgId      String        @map("org_id")
  sessionId  String        @map("session_id")
  session    ImportSession @relation(fields: [orgId, sessionId], references: [orgId, id], onDelete: Cascade)
  chunkIndex Int           @map("chunk_index")
  rowCount   Int           @map("row_count")
  payload    Json
  createdAt  DateTime      @default(now()) @map("created_at")

  @@id([orgId, sessionId, chunkIndex])
  @@map("import_staged_chunks")
}

model ImportMapping {
  id               Int      @id @default(autoincrement())
  orgId            String   @map("org_id")
  headersSignature String   @map("headers_signature")
  mappingJson      String   @map("mapping_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([orgId, headersSignature])
  @@index([orgId])
  @@map("import_mappings")
}

// Durable, shared-across-instances counters backing public-endpoint rate
// limits (AI Manager, smart importer). A plain in-memory counter doesn't
// work here: every serverless invocation can land on a different instance.
// `key` encodes scope + window, e.g. "ai:ip:1.2.3.4:2026-09-15T06:40" —
// callers bump the count atomically and compare it to their own limit.
model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowEnds  DateTime @map("window_ends")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([windowEnds])
  @@map("rate_limit_buckets")
}

// Batch-computed forecasting output — the model tournament (rolling-origin
// CV across 9 candidate models) is too slow to run on a page request (see
// docs/metrics.md and the forecasting-service README): a nightly batch job
// writes one row per SKU x warehouse here, and every read path (dashboard,
// forecast accuracy, stockout projections) reads only this table. Auxiliary
// cache table, same shape as RateLimitBucket/ImportMapping above — no FK to
// Product/Warehouse, since a stale row for a since-deleted SKU is harmless
// and simply won't be requested.
model ForecastResult {
  id             Int      @id @default(autoincrement())
  orgId          String   @map("org_id")
  sku            String
  warehouseId    Int      @map("warehouse_id")
  methodSelected String   @map("method_selected")
  methodReason   String   @map("method_reason")
  forecastJson   Json     @map("forecast_json")
  wape           Float
  mape           Float?
  bias           Float
  biasPct        Float    @map("bias_pct")
  rmse           Float
  mase           Float
  abcClass       String   @map("abc_class")
  xyzClass       String   @map("xyz_class")
  policyHint     String   @map("policy_hint")
  warningsJson   Json     @map("warnings_json")
  computedAt     DateTime @map("computed_at")

  @@unique([orgId, sku, warehouseId])
  @@index([orgId])
  @@index([orgId, computedAt])
  @@map("forecast_results")
}

