# ========================================================
# FORECASTING SERVICE — ENVIRONMENT VARIABLES (Render)
# ========================================================

# Shared secret checked on POST /forecast and POST /backtest via the
# X-Forecast-Secret header. Must be IDENTICAL to the web app's
# FORECAST_SERVICE_SECRET. GET /health is never gated by this.
FORECAST_SERVICE_SECRET="your-secure-shared-secret-key"

# Comma-separated list of exact browser origins allowed to call this
# service directly (CORS). The web app itself calls this service
# server-to-server and is not subject to CORS, but keep this locked
# down rather than wildcarded in case anything ever calls it from a
# browser (Swagger UI at /docs, a future client-side integration, etc).
CORS_ALLOWED_ORIGINS="https://supplychainmanager.app,http://localhost:3005"

# Optional: regex to also allow Vercel preview-deployment origins, which
# get a new hostname per deploy and can't be listed exactly. Leave unset
# to allow only the exact origins above.
# CORS_ALLOWED_ORIGIN_REGEX="https://supply-chain-manager-.*-alishba-khalids-projects\.vercel\.app"

# PORT is set automatically by Render — do not set it yourself.
