# ========================================================
# SUPPLY CHAIN MANAGER — ENVIRONMENT VARIABLES
# ========================================================

# Database (PostgreSQL / Neon / Supabase)
# Pooled connection string used by serverless runtime:
DATABASE_URL="postgres://user:password@host-pooler.neon.tech/dbname?sslmode=require&pgbouncer=true"

# Direct connection string used for Prisma migrations:
DIRECT_URL="postgres://user:password@host.neon.tech/dbname?sslmode=require"

# (Optional) Shadow database URL for Prisma schema diffing:
# SHADOW_DATABASE_URL="postgres://user:password@host.neon.tech/dbname_shadow?sslmode=require"

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Python Demand Forecasting Microservice (FastAPI on Render)
FORECAST_SERVICE_URL="https://forecasting-service.onrender.com"
FORECAST_SERVICE_SECRET="your-secure-shared-secret-key"

# Application Settings
# Optional override for SITE_URL in src/lib/site-config.ts (canonical tags,
# og:url, sitemap.xml, robots.txt). Leave unset to use the production
# default (https://supplychainmanager.app); set this for preview
# deployments or local dev if you need those surfaces to self-reference.
# NEXT_PUBLIC_SITE_URL="https://supply-chain-manager.vercel.app"
